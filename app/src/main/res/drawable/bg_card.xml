<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80EBEBEB" /> <!-- Background color -->
            <corners android:radius="@dimen/round_tag" /> <!-- Border radius -->
        </shape>
    </item>

    <!-- Shadow Layer -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:start="1dp"
        android:end="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" /> <!-- Shadow color -->
            <corners android:radius="@dimen/round_tag" /> <!-- Match background corner radius -->
        </shape>
    </item>
</layer-list>
