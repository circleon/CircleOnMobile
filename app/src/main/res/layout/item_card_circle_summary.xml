<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clItemCircleSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_padding_small"
    android:padding="@dimen/margin_padding_large"
    android:background="@drawable/bg_large_rounded_card">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCircleThumbnail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtCircleName">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgCircleThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtCircleName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_large"
        android:textAppearance="@style/default_bold_text"
        android:textColor="@color/grey_9"
        tools:text="circleName"
        app:layout_constraintStart_toEndOf="@id/cvCircleThumbnail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtCircleCategory"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtCircleCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_small"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        tools:text="Category"
        android:textColor="@color/purple_5"
        android:textSize="@dimen/text_size_x_small"
        android:background="@drawable/bg_chip"
        app:layout_constraintStart_toEndOf="@id/txtCircleName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        android:paddingHorizontal="@dimen/margin_padding_default"
        android:textColor="@color/white"
        android:textAppearance="@style/default_text"
        android:text="@string/btn_cancel_join_request"
        android:background="@drawable/bg_rounded_rectangle"
        android:backgroundTint="@color/purple_5"
        app:layout_constraintStart_toEndOf="@id/txtCircleCategory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
