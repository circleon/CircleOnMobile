<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editCircleMemberDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_padding_xx_large"
    android:background="@drawable/bg_rounded_rectangle"
    android:backgroundTint="@color/white">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/default_bold_text"
        android:textColor="@color/grey_9"
        tools:text="Title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/margin_padding_large"
        android:paddingVertical="10dp"
        android:paddingHorizontal="@dimen/margin_padding_large"
        android:background="@drawable/bg_card"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintBottom_toTopOf="@id/llNegativePositive">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_default"
            android:textColor="@color/grey_9"
            tools:text="Content"/>

    </ScrollView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llNegativePositive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_large"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svContent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:paddingHorizontal="@dimen/margin_padding_default"
            android:layout_weight="0.5"
            android:lineSpacingExtra="2sp"
            android:textSize="@dimen/text_size_default"
            android:textColor="@color/grey_6"
            android:text="@string/btn_cancel"
            android:background="@drawable/bg_rounded_rectangle"
            android:backgroundTint="@color/grey_3"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnAcceptLeaveRequest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_padding_small"
            android:paddingVertical="6dp"
            android:paddingHorizontal="@dimen/margin_padding_default"
            android:lineSpacingExtra="2sp"
            android:textSize="@dimen/text_size_default"
            android:textColor="@color/white"
            android:text="@string/btn_accept_leave_request"
            android:background="@drawable/bg_rounded_rectangle"
            android:backgroundTint="@color/purple_5"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>
