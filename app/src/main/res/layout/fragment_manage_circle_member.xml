<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.screen.home.ManageCircleMemberFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tbManageCircleMember"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/purple_5"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rvMember">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/margin_padding_large"
            android:paddingEnd="@dimen/margin_padding_small"
            android:src="@drawable/ic_back"
            app:tint="@color/white"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtTbTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/large_bold_text"
            android:textColor="@color/white"
            tools:text="title"/>

    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMember"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/margin_padding_large"
        app:layout_constraintTop_toBottomOf="@id/tbManageCircleMember"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
