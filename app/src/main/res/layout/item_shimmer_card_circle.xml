<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clItemCircle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_padding_large"
    android:layout_marginBottom="@dimen/margin_padding_small"
    android:background="@drawable/bg_large_rounded_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clCircleInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cvCircleThumbnail"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constrainedWidth="true"
        >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llCircleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtCircleName"
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_rounded_rectangle"
                android:backgroundTint="@color/shimmer"
                android:textAppearance="@style/content_title"
                android:textSize="@dimen/text_size_default" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtCircleCategory"
                android:layout_width="60dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/margin_padding_small"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/purple_5"
                android:textSize="@dimen/text_size_x_small"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/shimmer"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtCircleComment"
            android:layout_width="200dp"
            android:layout_height="10dp"
            android:layout_marginVertical="@dimen/margin_padding_small"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/grey_9"
            android:maxLines="2"
            android:maxLength="35"
            android:background="@drawable/bg_rounded_rectangle"
            android:backgroundTint="@color/shimmer"
            app:layout_constraintTop_toBottomOf="@id/llCircleName"
            app:layout_constraintBottom_toTopOf="@id/llCircleMember"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llCircleMember"
            android:layout_width="100dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/margin_padding_small"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_rectangle"
            android:backgroundTint="@color/shimmer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txtCircleMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_padding_x_small"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/grey_9"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCircleThumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="40dp"
        app:cardCornerRadius="@dimen/round_default"
        app:cardElevation="0dp"
        android:backgroundTint="@color/shimmer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/clCircleInfo"
        app:layout_constraintHorizontal_bias="1">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgCircleThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
