<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.screen.circle.MyCircleFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_1">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbCircles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/flCircles">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/margin_padding_large"
                android:paddingEnd="@dimen/margin_padding_small"
                android:src="@drawable/ic_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtTitleCircles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/large_bold_text"
                android:textColor="@color/grey_9"
                tools:text="title"/>

        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            android:id="@+id/flCircles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="@dimen/margin_padding_large"
            app:layout_constraintTop_toBottomOf="@id/tbCircles"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCircles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llNoMyCircles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/large_text"
                    android:textColor="@color/grey_5"
                    android:text="@string/message_no_my_circles"
                    android:gravity="center" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/btnMoveToSearchCircleScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_large"
                    android:paddingVertical="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="@dimen/margin_padding_default"
                    android:background="@drawable/bg_purple_outlined_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_search"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_padding_x_small"
                        android:text="@string/btn_move_to_search_circle_screen"
                        android:textColor="@color/purple_5"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llNoJoinRequestedCircles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/large_text"
                    android:textColor="@color/grey_5"
                    android:text="@string/message_no_join_requested_circles"
                    android:gravity="center" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_large"
                    android:src="@drawable/ic_good_situation"/>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llNoLeaveRequestedCircles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/large_text"
                    android:textColor="@color/grey_5"
                    android:text="@string/message_no_leave_requested_circles"
                    android:gravity="center" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_large"
                    android:src="@drawable/ic_good_situation"/>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pgbLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_padding_large"
        android:layout_gravity="center"
        app:indicatorColor="@color/purple_5"
        app:trackColor="@color/grey_3"
        app:trackThickness="8dp"
        app:trackCornerRadius="@dimen/round_default"
        android:visibility="gone"
        android:indeterminate="true">

    </com.google.android.material.progressindicator.CircularProgressIndicator>

</FrameLayout>
