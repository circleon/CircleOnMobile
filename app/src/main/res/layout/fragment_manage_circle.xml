<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.screen.home.ManageCircleFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_1">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbManageCircle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/llManageCircle">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/margin_padding_large"
                android:paddingEnd="@dimen/margin_padding_small"
                android:src="@drawable/ic_cancel" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/large_bold_text"
                android:textColor="@color/grey_9"
                android:text="@string/title_manage_circle"/>

        </androidx.appcompat.widget.Toolbar>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llManageCircle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_padding_large"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tbManageCircle"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCircleMember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_large_rounded_card"
                android:paddingStart="@dimen/margin_padding_xx_large"
                android:paddingEnd="@dimen/margin_padding_large"
                android:paddingVertical="@dimen/margin_padding_large">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtContentTitleCircleMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_circle_title_circle_member"
                    android:textAppearance="@style/default_bold_text"
                    android:textColor="@color/purple_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txtCircleMember"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtCircleMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_x_small"
                    android:textColor="@color/grey_6"
                    android:textSize="@dimen/text_size_small"
                    android:text="@string/manage_circle_content_circle_member_default"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtContentTitleCircleMember"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clApproveCircleJoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_small"
                android:background="@drawable/bg_large_rounded_card"
                android:paddingStart="@dimen/margin_padding_xx_large"
                android:paddingEnd="@dimen/margin_padding_large"
                android:paddingVertical="@dimen/margin_padding_large">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtContentTitleApproveCircleJoin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_circle_title_approve_circle_join"
                    android:textAppearance="@style/default_bold_text"
                    android:textColor="@color/purple_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txtJoinRequestedMember"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtJoinRequestedMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_x_small"
                    android:text="@string/manage_circle_content_join_requested_member_default"
                    android:textColor="@color/grey_6"
                    android:textSize="@dimen/text_size_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtContentTitleApproveCircleJoin" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clApproveCircleLeave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_small"
                android:background="@drawable/bg_large_rounded_card"
                android:paddingStart="@dimen/margin_padding_xx_large"
                android:paddingEnd="@dimen/margin_padding_large"
                android:paddingVertical="@dimen/margin_padding_large">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtContentTitleApproveCircleLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_circle_title_approve_circle_leave"
                    android:textAppearance="@style/default_bold_text"
                    android:textColor="@color/purple_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txtLeaveRequestedMember"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtLeaveRequestedMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_x_small"
                    android:textColor="@color/grey_6"
                    android:textSize="@dimen/text_size_small"
                    android:text="@string/manage_circle_content_leave_requested_member_default"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtContentTitleApproveCircleLeave"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pgbLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_padding_large"
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_rectangle"
        android:backgroundTint="@color/bg_indicator"
        app:indicatorColor="@color/purple_5"
        app:trackColor="@color/grey_3"
        app:trackThickness="8dp"
        app:trackCornerRadius="@dimen/round_default"
        android:visibility="gone"
        android:indeterminate="true">

    </com.google.android.material.progressindicator.CircularProgressIndicator>

</FrameLayout>
