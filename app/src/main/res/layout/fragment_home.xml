<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_1"
    android:orientation="vertical"
    tools:context=".view.screen.home.HomeFragment">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_xx_large"
        android:layout_marginEnd="@dimen/margin_padding_large"
        app:contentInsetStart="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_home"/>

        <androidx.cardview.widget.CardView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/margin_padding_large"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp"
            android:layout_gravity="end" >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgUserProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center" />

        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_padding_large"
            android:layout_gravity="end"
            android:src="@drawable/ic_notification" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:src="@drawable/ic_search" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtUnivName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_padding_default"
        android:layout_marginStart="@dimen/margin_padding_xx_large"
        android:layout_marginEnd="@dimen/margin_padding_large"
        android:text="대학교"
        android:textAppearance="@style/content_title"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_xx_large"
        android:paddingVertical="@dimen/margin_padding_x_small" >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCircleCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtContentTitleCircle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_xx_large"
        android:layout_marginEnd="@dimen/margin_padding_large"
        android:paddingVertical="@dimen/margin_padding_small"
        android:textAppearance="@style/content_title"
        android:textSize="16sp"
        android:text="@string/home_content_title_circle_default"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/margin_padding_large"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCircle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerCircle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:shimmer_duration="2000"
            app:shimmer_highlight_alpha="0.4">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

                <include layout="@layout/item_shimmer_card_circle"/>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtNoCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="140dp"
            android:gravity="center"
            android:text="@string/message_no_circle"
            android:textAppearance="@style/large_text"
            android:textColor="@color/grey_5"
            android:visibility="gone"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llServiceError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_service_error"
                android:textAppearance="@style/large_text"
                android:textColor="@color/grey_5"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_small"
                android:src="@drawable/ic_retry" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
