<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.screen.home.NewPostFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_1">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbPostDetail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/edtPostContent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/margin_padding_large"
                android:paddingEnd="@dimen/margin_padding_small"
                android:src="@drawable/ic_cancel" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtTbTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/large_bold_text"
                android:textColor="@color/grey_9"
                tools:text="title"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnUpload"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/margin_padding_large"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="@string/btn_finish"
                android:textAppearance="@style/small_bold_text"
                android:textColor="@color/purple_5" />

        </androidx.appcompat.widget.Toolbar>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edtPostContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_padding_small"
            android:padding="@dimen/margin_padding_large"
            android:gravity="top"
            android:hint="@string/hint_post_content"
            android:textColorHint="@color/grey_5"
            android:textSize="@dimen/text_size_default"
            android:textColor="@color/grey_9"
            android:maxLength="1000"
            android:lineSpacingExtra="2sp"
            android:translationY="-1.06sp"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@id/tbPostDetail"
            app:layout_constraintBottom_toTopOf="@id/llPostImg"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llPostImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_padding_small"
            android:padding="@dimen/margin_padding_default"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtPostContent"
            app:layout_constraintBottom_toBottomOf="parent" >

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnAddPostImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_add"
                    android:scaleType="center"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_dotted_rounded_rectangle" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnRemovePostImage"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="@dimen/margin_padding_x_small"
                    android:layout_gravity="top|end"
                    android:src="@drawable/ic_cancel"
                    app:tint="@color/grey_5"
                    android:visibility="gone" />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtAddPostImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_padding_large"
                android:text="@string/add_image"
                android:textColor="@color/grey_5"
                android:textSize="@dimen/text_size_default"
                android:lineSpacingExtra="2sp"
                android:translationY="-1.06sp"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pgbContentLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_padding_large"
        android:background="@drawable/bg_rounded_rectangle"
        android:backgroundTint="@color/grey_3"
        android:layout_gravity="center"
        app:indicatorColor="@color/purple_5"
        app:trackColor="@color/grey_3"
        app:trackThickness="1dp"
        android:indeterminate="true"
        android:visibility="gone">

    </com.google.android.material.progressindicator.CircularProgressIndicator>

</FrameLayout>
